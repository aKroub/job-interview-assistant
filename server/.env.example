# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
#
# To get these values:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or use an existing one)
# 3. Enable the Gmail API and Google Calendar API
# 4. Go to Credentials → Create OAuth 2.0 Client ID
# 5. Set application type to "Web application"
# 6. Add http://localhost:3001/api/auth/callback as an authorized redirect URI
# 7. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Port for the Express server (default: 3001)
PORT=3001

# How often to poll Gmail/Calendar in milliseconds (default: 300000 = 5 minutes)
POLL_INTERVAL_MS=300000

# How far back to scan emails in days (default: 1)
EMAIL_LOOKBACK_DAYS=1

# How far ahead to scan calendar events in days (default: 30)
CALENDAR_LOOKAHEAD_DAYS=30
